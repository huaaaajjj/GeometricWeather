<?xml version="1.0" encoding="utf-8"?><!--
  One detail as a tile: label above the reading said in words on the left, and on the right either a
  gauge holding the number itself (when the reading has a range worth showing) or the plain icon it
  always had. Two of these per row.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_details"
    android:layout_width="match_parent"
    android:layout_height="@dimen/details_tile_height"
    app:cardCornerRadius="@dimen/material3_card_list_item_corner_radius"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/normal_margin"
        android:paddingEnd="@dimen/little_margin">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_details_title"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/subtitle_text"
                tools:text="紫外线" />

            <TextView
                android:id="@+id/item_details_content"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:autoSizeMaxTextSize="@dimen/large_title_text_size"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeTextType="uniform"
                style="@style/large_title_text"
                tools:text="舒适" />

        </LinearLayout>

        <wangdaye.com.geometricweather.common.ui.widgets.ArcProgress
            android:id="@+id/item_details_progress"
            android:layout_width="@dimen/details_tile_gauge_size"
            android:layout_height="@dimen/details_tile_gauge_size"
            app:arc_angle="270"
            app:background_color="?attr/colorOutline"
            app:bottom_text_color="?attr/colorCaptionText"
            app:bottom_text_size="10dp"
            app:max="100"
            app:progress_width="5dp"
            app:text_color="?attr/colorTitleText"
            app:text_size="18dp"
            tools:bottom_text="UV"
            tools:progress="50"
            tools:text="5" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_details_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/little_margin"
            android:layout_marginEnd="@dimen/normal_margin"
            android:src="@drawable/ic_forecast"
            android:visibility="gone"
            app:tint="?attr/colorTitleText"
            tools:ignore="ContentDescription" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
