<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_main_first_card_header"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selectable_item_background">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/container_main_first_card_header_timeIcon"
            android:layout_width="@dimen/standard_weather_icon_size"
            android:layout_height="@dimen/standard_weather_icon_size"
            android:padding="@dimen/normal_margin"
            android:src="@drawable/ic_time"
            android:tint="?attr/colorTitleText"
            android:background="@drawable/selectable_item_background"
            tools:ignore="ContentDescription,RtlHardcoded" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:layout_marginBottom="@dimen/normal_margin">

            <TextView
                android:id="@+id/container_main_first_card_header_timeText"
                style="@style/title_text"
                tools:text="09:00"
                tools:ignore="RelativeOverlap,RtlHardcoded,RtlSymmetry" />

            <TextClock
                android:id="@+id/container_main_first_card_header_localTimeText"
                style="@style/subtitle_text"
                tools:text="当地时间 : 4月33日 06:00 星期日"
                tools:ignore="RelativeOverlap,RtlHardcoded,RtlSymmetry" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>