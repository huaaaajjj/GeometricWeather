<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_main_details"
    android:layout_margin="0dp"
    style="@style/material_card">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/container_main_details_title"
            android:text="@string/life_details"
            android:layout_margin="@dimen/normal_margin"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            style="@style/title_text" />

        <!-- The gauge grid fills the whole card, and a RecyclerView eats the touch so the card's
             own ripple never fires there — the one card that felt un-tappable. It never scrolls
             (fixed wrap_content grid), so making it clickable with the same ripple foreground gives
             click feedback over the grid at the shared brightness, without blocking the page scroll. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/container_main_details_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clickable="true"
            android:foreground="@drawable/selectable_item_background"
            tools:ignore="UnusedAttribute" />

    </LinearLayout>

</androidx.cardview.widget.CardView>